#include <windows.h>

// --------------------------------------------------
// Application icon
// --------------------------------------------------
IDI_ICON1 ICON "app.ico"


// --------------------------------------------------
// Version information
// --------------------------------------------------
VS_VERSION_INFO VERSIONINFO
    FILEVERSION 1,0,0,0
    PRODUCTVERSION 1,0,0,0

    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // English (United States), Unicode
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ThaKhinSoe Enterprise\0"
            VALUE "FileDescription", "QR Code Generator\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "Project Itachi\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 SoeTheGreat\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "QrGenerator.exe\0"
            VALUE "ProductName", "QR Code Generator\0"
            VALUE "ProductVersion", "1.0.0.0\0"
            VALUE "Comments", "A complex QR Code Generator application.\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
